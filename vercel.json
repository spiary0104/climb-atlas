{
  "redirects": [
    {
      "source": "/import/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tests/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/scripts/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/design/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.claude/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/data/reconciliation/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/data/backups/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/data/gyms.reconciled.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/docs/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/supabase/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(Rules|CLAUDE|README|WORKFLOW_GUIDE).md",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/gym/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": "(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|TelegramBot|LinkedInBot|Pinterestbot|redditbot|Applebot|SkypeUriPreview|Embedly|Iframely|vkShare|Mastodon|Bluesky|Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot|Baiduspider|Yeti|Naverbot|SeznamBot|Qwantbot)"
          }
        }
      ],
      "destination": "/api/seo?slug=:slug"
    },
    {
      "source": "/in",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": "(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|TelegramBot|LinkedInBot|Pinterestbot|redditbot|Applebot|SkypeUriPreview|Embedly|Iframely|vkShare|Mastodon|Bluesky|Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot|Baiduspider|Yeti|Naverbot|SeznamBot|Qwantbot)"
          }
        }
      ],
      "destination": "/api/seo?path="
    },
    {
      "source": "/in/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": "(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|TelegramBot|LinkedInBot|Pinterestbot|redditbot|Applebot|SkypeUriPreview|Embedly|Iframely|vkShare|Mastodon|Bluesky|Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot|Baiduspider|Yeti|Naverbot|SeznamBot|Qwantbot)"
          }
        }
      ],
      "destination": "/api/seo?path=:path*"
    },
    {
      "source": "/gym/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/in",
      "destination": "/index.html"
    },
    {
      "source": "/in/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/log",
      "destination": "/index.html"
    },
    {
      "source": "/me",
      "destination": "/index.html"
    },
    {
      "source": "/me/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/mod",
      "destination": "/index.html"
    },
    {
      "source": "/add",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://thayxaampaelvntoaido.supabase.co wss://thayxaampaelvntoaido.supabase.co https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com https://unpkg.com https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self' blob:; child-src blob:; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "preview.bouldeer.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/seo.mjs": {
      "includeFiles": "{index.html,js/supabase-init.js,js/modules/seo-meta.js,api/_places.json}"
    }
  }
}
