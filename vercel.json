{
  "redirects": [
    {
      "source": "/docs/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/supabase/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(Rules|CLAUDE|README|WORKFLOW_GUIDE).md",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/gym/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/in",
      "destination": "/index.html"
    },
    {
      "source": "/in/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/log",
      "destination": "/index.html"
    },
    {
      "source": "/me",
      "destination": "/index.html"
    },
    {
      "source": "/me/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/mod",
      "destination": "/index.html"
    },
    {
      "source": "/add",
      "destination": "/index.html"
    }
  ]
}
