{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "climbatlas.org" }],
      "destination": "https://www.bouldeer.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.climbatlas.org" }],
      "destination": "https://www.bouldeer.com/:path*",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/supabase/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(Rules|CLAUDE|README|WORKFLOW_GUIDE).md",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/gym/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/in",
      "destination": "/index.html"
    },
    {
      "source": "/in/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/log",
      "destination": "/index.html"
    },
    {
      "source": "/me",
      "destination": "/index.html"
    },
    {
      "source": "/me/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/mod",
      "destination": "/index.html"
    },
    {
      "source": "/add",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://thayxaampaelvntoaido.supabase.co wss://thayxaampaelvntoaido.supabase.co https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com https://unpkg.com https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self' blob:; child-src blob:; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()" }
      ]
    }
  ]
}
